# tool/session state
.claude/
.ssh/
# python
__pycache__/
*.pyc
# generated artifacts
scenarios/build/
pipeline/runs/
pipeline/t1/
!pipeline/results/
pipeline/run_ledger.jsonl
# secrets
config.json
*.env
.env.local
# plugin-generated context stubs
pipeline/results/**/CLAUDE.md
# claude-mem also drops CLAUDE.md stubs beside paths it saw touched, including mirrored/stray locations
/Library/
/runpod_watch/
/harness/CLAUDE.md
pipeline/build/
pipeline/pipeline/
pipeline/harness/pipeline/
pipeline/scenarios/
scenarios/arm_a/*/scenarios/
# mirrored stub trees anywhere (claude-mem writes CLAUDE.md beside touched paths, recursively under results)
**/pipeline/pipeline/
**/results/**/pipeline/
# plugin stubs outside pipeline/ (the tracked ones under pipeline/ stay tracked; gitignore does not affect them)
scenarios/**/CLAUDE.md
tools/**/CLAUDE.md

# derived generation sets from harness.relabel are reproducible from main_run + the rules; keep only the summary
pipeline/results/**/relabel_*/generation/
pipeline/results/**/relabel_*/manifest.json
pipeline/results/**/relabel_*/cardinality.json
pipeline/eval/
# joined analysis directories copy member generation files (harness.join_runs); keep manifest, cardinality, analysis
pipeline/results/**/*_joined/generation/
pipeline/results/*/relabel_*/generation/
pipeline/results/*/relabel_*/manifest.json
pipeline/results/*/relabel_*/cardinality.json
# probe-transfer activations (316 MB; kept locally, re-derivable on a pod)
pipeline/results/t4_27b_2026-10-02_probe_transfer*/**/activations.npz

# pod tarballs and copy-back archives (tools/runpod_watch/ship.sh, fetch.sh)
.ship/
