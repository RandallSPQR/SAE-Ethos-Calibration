# tool/session state
.claude/
.ssh/
# macOS Finder metadata
.DS_Store
# python
__pycache__/
*.pyc
# generated artifacts
scenarios/build/
pipeline/runs/
pipeline/t1/
!pipeline/results/
pipeline/run_ledger.jsonl
# secrets
config.json
*.env
.env.local
# claude-mem writes placeholder CLAUDE.md stubs beside every path it sees touched (any depth, including mirrored stray
# trees). None is project documentation: all 38 that had been committed were pure stubs and were removed 2026-10-09
# (handoff cleanup). Ignored everywhere; a real CLAUDE.md, if ever wanted, is added with `git add -f`.
CLAUDE.md
/Library/
/runpod_watch/
pipeline/build/
pipeline/pipeline/
pipeline/harness/pipeline/
pipeline/scenarios/
scenarios/arm_a/*/scenarios/
# mirrored stub trees anywhere (claude-mem writes CLAUDE.md beside touched paths, recursively under results)
**/pipeline/pipeline/
**/results/**/pipeline/
# scenario templates are rendered verbatim into the agent's repo: no droppings there (harness change 2026-10-08.3;
# two CLAUDE.md stubs tracked before the rule above were rendered until then; harness.fixtures checks git ls-files too)
scenarios/arm_a/**/repo_template/**/CLAUDE.md
scenarios/arm_a/**/repo_template/**/.DS_Store
scenarios/arm_a/**/repo_template/**/._*

# derived generation sets from harness.relabel are reproducible from main_run + the rules; keep only the summary
pipeline/results/**/relabel_*/generation/
pipeline/results/**/relabel_*/manifest.json
pipeline/results/**/relabel_*/cardinality.json
pipeline/eval/
# joined analysis directories copy member generation files (harness.join_runs); keep manifest, cardinality, analysis
pipeline/results/**/*_joined/generation/
pipeline/results/*/relabel_*/generation/
pipeline/results/*/relabel_*/manifest.json
pipeline/results/*/relabel_*/cardinality.json
# probe-transfer activations (316 MB; kept locally, re-derivable on a pod)
pipeline/results/t4_27b_2026-10-02_probe_transfer*/**/activations.npz

# pod tarballs and copy-back archives (tools/runpod_watch/ship.sh, fetch.sh)
.ship/
